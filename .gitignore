# === Archive maître des médias — JAMAIS versionnée ===
# 482 fichiers, ~900 Mo : ce sont tes images, le dépôt est destiné à devenir
# public, et git n'est pas fait pour du binaire lourd. Seul l'inventaire —
# URLs, tailles, empreintes SHA-256 — est versionné, à la racine.
archive_medias/

# === Export Substack — JAMAIS versionné ===
# Contient les adresses des abonnés et le corpus intégral, dont des
# articles réservés aux abonnés payants. Le dépôt ne garde que les
# métadonnées dérivées, dans data/.
export_substack/
substack/
posts/
email_list*.csv
posts.csv
*.delivers.csv
*.opens.csv

# === Secrets — ne jamais versionner ===
*.env
.env
.env.*
*.key
*.pem
credentials.json
secrets.yaml
private/

# === Sauvegardes automatiques du serveur ===
# Horodatées, régénérées à chaque enregistrement. C'est du bruit dans l'historique :
# git tient déjà l'historique des données.
data/_versions/
data/_sauvegarde/

# === Python ===
__pycache__/
*.py[cod]
venv/
.venv/

# === Systèmes et éditeurs ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
